{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "qa:critical": "node scripts/verify-critical-flows.mjs && node scripts/verify-multitenant-isolation.mjs && node scripts/verify-center-identity-contract.mjs",
    "qa:center-contract": "node scripts/verify-center-identity-contract.mjs",
    "qa:multitenant": "node scripts/verify-multitenant-isolation.mjs",
    "qa:production": "node scripts/verify-production-readiness.mjs",
    "qa:release": "npm run typecheck && npm --prefix functions run build && npm run build && npm run qa:critical",
    "deploy:storage": "firebase deploy --only storage:rules",
    "deploy:firestore": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:all": "firebase deploy"
  },
