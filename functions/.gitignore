# Compiled JavaScript files
lib/**/*.js
lib/**/*.js.map

# TypeScript v1 declaration files
typings/

# Node.js dependency directory
node_modules/

# Local override files
*.local

# === Environment files (NEVER commit secrets) ===
# Root envs
.env
.env.*
!.env.example

# Functions envs
functions/.env
functions/.env.*
!functions/.env.example

# Firebase / emulator artifacts
.firebase/
.firebaserc.local

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# OS junk
.DS_Store
Thumbs.db
