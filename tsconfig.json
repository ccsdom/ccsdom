{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["node", "react", "react-dom"],

    "noEmit": true               // ✅ ne produit plus de .js en sortie
  },
  "include": ["src", "vite-env.d.ts"]  // ✅ utile si Vite ajoute ses types
}
